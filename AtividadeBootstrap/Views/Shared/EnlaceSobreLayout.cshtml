<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Enlace</title>

    <link rel="stylesheet"
          href="~/css/sobre.css"
          asp-append-version="true" />

</head>

<body>

    <header class="enlace-header">

        <a class="enlace-logo"
           asp-controller="Sobre"
           asp-action="Sobre">
            Enlace
        </a>

        <nav class="enlace-nav">

            <a class="active"
               asp-controller="Sobre"
               asp-action="Sobre">
                Sobre
            </a>

            <a asp-controller="Servicos"
               asp-action="Servicos">
                Serviços
            </a>

            <a asp-controller="Depoimentos"
               asp-action="Depoimentos">
                Depoimentos
            </a>

        </nav>

    </header>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>